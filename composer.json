{
    "name": "publish-php/statamic-standard-site",
    "description": "Sync Statamic entries to standard.site on the AT Protocol",
    "type": "statamic-addon",
    "license": "MIT",
    "keywords": ["statamic", "atproto", "bluesky", "standard-site", "site.standard"],
    "authors": [
        {
            "name": "Chazona Baum",
            "homepage": "https://chazonabaum.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "statamic/cms": "^6.0",
        "publish-php/atproto-standard-site": "^1.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "PublishPhp\\StatamicStandardSite\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PublishPhp\\StatamicStandardSite\\Tests\\": "tests/"
        }
    },
    "extra": {
        "statamic": {
            "name": "Standard Site",
            "description": "Sync entries to standard.site on the AT Protocol"
        },
        "laravel": {
            "providers": [
                "PublishPhp\\StatamicStandardSite\\ServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
